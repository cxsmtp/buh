# ==========================================
# BEAUTIFUL UAE HOME - REAL SMS & OTP CONFIG
# ==========================================
# To send physical SMS OTP to actual mobile devices in the UAE (Etisalat & du),
# configure either Twilio or Infobip credentials below:

# ------------------------------------------
# OPTION 1: TWILIO SMS GATEWAY (Recommended)
# Sign up free at: https://www.twilio.com/try-twilio
# ------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=+12025550143
# Optional: Twilio Verify Service SID
TWILIO_VERIFY_SERVICE_SID=

# ------------------------------------------
# OPTION 2: INFOBIP UAE SMS GATEWAY
# Portal: https://portal.infobip.com
# ------------------------------------------
INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://api.infobip.com

# ------------------------------------------
# OPTION 3: UNIFONIC MIDDLE EAST SMS
# Portal: https://www.unifonic.com
# ------------------------------------------
UNIFONIC_APP_SID=

# ------------------------------------------
# OPTION 4: CUSTOM WEBHOOK (e.g. WhatsApp Bot or Internal Gateway)
# ------------------------------------------
SMS_WEBHOOK_URL=
