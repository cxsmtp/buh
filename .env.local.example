# ==========================================
# BEAUTIFUL UAE HOME - LOCAL DEVELOPMENT
# ==========================================
# Without any SMS gateway, checkout runs in test mode: the 6-digit code is
# shown on screen (never in production unless OTP_DEV_MODE=true).

# Admin account: leave empty and a one-time password is printed to the
# server log on first start (you choose your own at first sign-in).
# ADMIN_EMAIL=admin@beautifuluaehome.com
# ADMIN_PASSWORD_HASH=   # from: npm run hash-password

# Where the admin account, session key and audit log are kept.
# DATA_DIR=.data

# Shown to customers with non-UAE numbers ("please email us").
NEXT_PUBLIC_SUPPORT_EMAIL=orders@beautifuluaehome.com

# ------------------------------------------
# SMS gateway for checkout phone verification (pick one)
# ------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_SENDER_ID=BUHome

# Your own gateway: receives POST {to, code, message} over https.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
