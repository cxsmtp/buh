# Beautiful UAE Home - Production Environment Variables
# Copy this file to .env.production on Hostinger VPS or add to hPanel Environment Settings

NODE_ENV=production
PORT=3000

# Next.js Public URL
NEXT_PUBLIC_APP_URL=https://yourdomain.ae

# Twilio SMS Carrier Configuration (Option 1 for OTP)
# Get credentials from twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Infobip UAE Gateway Configuration (Option 2 for direct UAE e& / du delivery)
# Get credentials from infobip.com
INFOBIP_BASE_URL=https://xxxxxx.api.infobip.com
INFOBIP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INFOBIP_SENDER_ID=BUHome

# Eco Express Courier Integration
# Obtain live token and account ID from Eco Express sales team
ECO_EXPRESS_API_KEY=your_production_eco_key
ECO_EXPRESS_ACCOUNT_ID=your_eco_account_id

# Jeebly Courier Integration
# Obtain live partner key from Jeebly portal
JEEBLY_PARTNER_KEY=your_jeebly_partner_key
