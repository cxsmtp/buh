# Beautiful UAE Home — production settings. Copy to .env.production (never commit it).
# Most shop settings (SMS gateway, couriers, bank details, branding) are set in the
# Admin Hub after the first sign-in; only what the server needs to start is here.

# ── Your domain (Caddy gets the HTTPS certificate for it) ─────────────────────
DOMAIN=yourdomain.ae
ACME_EMAIL=you@yourdomain.ae
NEXT_PUBLIC_APP_URL=https://yourdomain.ae
# Shown to customers with non-UAE numbers ("please email us").
NEXT_PUBLIC_SUPPORT_EMAIL=orders@yourdomain.ae

# ── Backups: every 12 hours, emailed (REQUIRED for a live shop) ───────────────
# Gmail: turn on 2-step verification, create an App Password
# (Google Account → Security → App passwords) and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourshop.backups@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=Beautiful UAE Home <yourshop.backups@gmail.com>
# Who receives the backups (comma-separated for several).
BACKUP_EMAIL=owner@yourdomain.ae
# Strongly recommended (12+ characters): encrypts the emailed backup (customer names, phones, addresses).
# Keep this passphrase somewhere safe OFF the server — without it a backup cannot be opened.
BACKUP_PASSPHRASE=
# BACKUP_INTERVAL_HOURS=12

# ── Admin account (optional) ──────────────────────────────────────────────────
# If unset, the first start prints a one-time password in the log
# (docker compose logs app) that you replace at first sign-in.
# ADMIN_EMAIL=owner@yourdomain.ae
# ADMIN_PASSWORD_HASH='scrypt$16384$8$1$...'   # from: npm run hash-password

# ── SMS gateway (optional here: can be set in Admin Hub → SMS instead) ───────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_PHONE=+1xxxxxxxxxx
# INFOBIP_BASE_URL=https://xxxxxx.api.infobip.com
# INFOBIP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# INFOBIP_SENDER_ID=BUHome
# OTP_MAX_PER_HOUR=300
