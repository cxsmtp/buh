# Beautiful UAE Home - Production Environment Variables
# Copy to .env.production on the VPS (never commit it).

NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://yourdomain.ae
NEXT_PUBLIC_SUPPORT_EMAIL=orders@yourdomain.ae

# Behind nginx (deploy/nginx-buhome.conf sets X-Real-IP). Leave unset if the
# app is reachable directly, or clients could fake their address.
TRUST_PROXY=1

# Admin account, session key and audit log (owner-only folder; back it up).
DATA_DIR=/var/lib/buhome

# Admin account. Optional: if unset, a one-time password is printed in the
# server log at first start and must be changed at first sign-in.
# Make the hash with:  npm run hash-password   (keep the single quotes)
# ADMIN_EMAIL=owner@yourdomain.ae
# ADMIN_PASSWORD_HASH='scrypt$16384$8$1$...'

# Optional: at least 32 random characters. If unset, a key is generated in DATA_DIR.
# SESSION_SECRET=

# ── SMS gateway for checkout phone verification (UAE numbers) ──
# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_PHONE=+1xxxxxxxxxx
# or Infobip (direct UAE e& / du delivery)
# INFOBIP_BASE_URL=https://xxxxxx.api.infobip.com
# INFOBIP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# INFOBIP_SENDER_ID=BUHome
# or your own https gateway: POST {to, code, message}
# SMS_WEBHOOK_URL=https://sms.yourdomain.ae/send
# SMS_WEBHOOK_TOKEN=

# Countries codes may be sent to (comma-separated). Default: UAE only.
# OTP_ALLOWED_PREFIXES=+971
# Circuit breaker against SMS-pumping fraud: max codes per hour, shop-wide.
# OTP_MAX_PER_HOUR=300
