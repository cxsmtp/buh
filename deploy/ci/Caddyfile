# CI only (.github/workflows/zero-downtime.yml): the production site block
# (../shop.caddy) on plain http, port 8080, so no certificate is requested.
{
	auto_https off
	# Caddy's own messages (a shop copy that cannot be reached, say) name the request too: the
	# Admin Hub's private link is masked there as well (the access log: shop-snippets.caddy).
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "^(?:((?:/(?:api/)?(?:pay|deal))?/[A-Za-z0-9_-]{4})[A-Za-z0-9_-]{28,}|(/(?:track|invoice)/BUH-[A-Z0-9-]{4,40}[.][A-Za-z0-9_-]{4})[A-Za-z0-9_-]{39})" "${1}${2}..."
				request>headers>Referer delete
				# A customer's chat is opened with this header: never in the log.
				request>headers>X-Chat-Token delete
				# The one-time move to a new admin link is a redirect: its Location is the link.
				resp_headers>Location delete
			}
		}
	}
}

import ../shop-snippets.caddy

:8080 {
	import ../shop.caddy
}
