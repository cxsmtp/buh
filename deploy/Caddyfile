# Beautiful UAE Home — Caddy in front of the shop (docker-compose.yml).
# Free HTTPS certificates from Let's Encrypt, renewed automatically; HTTP → HTTPS.
# DOMAIN and ACME_EMAIL come from .env.production.
# The site itself (the two shop copies) is in shop.caddy, which the CI test (deploy/ci/Caddyfile)
# imports too, so the config tested there is this one; the protections are in shop-snippets.caddy,
# shared with the buh-proxy image.
# After changing either file: docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
{
	email {$ACME_EMAIL}
	# Caddy's own messages (a shop copy that cannot be reached, say) name the request too: the
	# Admin Hub's private link is masked there as well (the access log: shop-snippets.caddy).
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "^(/(?:api/)?pay)?/([A-Za-z0-9_-]{4})[A-Za-z0-9_-]{28,}" "${1}/${2}..."
				request>headers>Referer delete
				# The one-time move to a new admin link is a redirect: its Location is the link.
				resp_headers>Location delete
			}
		}
	}
}

import shop-snippets.caddy

{$DOMAIN} {
	import shop.caddy
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
