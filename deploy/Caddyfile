# Beautiful UAE Home — Caddy in front of the shop (docker-compose.yml).
# Free HTTPS certificates from Let's Encrypt, renewed automatically; HTTP → HTTPS.
# DOMAIN and ACME_EMAIL come from .env.production.
# The site itself (limits, the two shop copies, headers, logs) is in shop.caddy, which the
# CI test (deploy/ci/Caddyfile) imports too, so the config tested there is this one.
# After changing either file: docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	import shop.caddy
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
